# ── OrionVolt User App — Required Environment Variables ──
# Copy this file to .env and fill in your values.

# Supabase (frontend — publishable/anon key only, NEVER the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Express backend API base URL
VITE_API_URL=http://localhost:5000/api

# Razorpay (public key only — secret stays on backend)
VITE_RAZORPAY_KEY_ID=
